{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonic Dominion",
  "mainBinaryName": "Sonic Dominion",
  "version": "3.0.0",
  "identifier": "com.sonicdominion.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sonic Dominion",
        "width": 1240,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#141311",
        "backgroundThrottling": "disabled",
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-gpu --in-process-gpu --enable-features=NetworkServiceInProcess2 --disable-features=AudioServiceOutOfProcess,msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication,SpareRendererForSitePerProcess --disable-background-networking --disable-component-update --no-pings --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
