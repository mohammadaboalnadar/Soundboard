{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonic Dominion",
  "mainBinaryName": "Sonic Dominion",
  "version": "3.4.1",
  "identifier": "com.sonicdominion.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sonic Dominion",
        "width": 1240,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#141311",
        "backgroundThrottling": "disabled",
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-gpu --in-process-gpu --enable-features=NetworkServiceInProcess2 --disable-features=AudioServiceOutOfProcess,msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication,SpareRendererForSitePerProcess --disable-background-networking --disable-component-update --no-pings --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "Sonic Dominion",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    },
    "publisher": "Sonic Dominion",
    "copyright": "Copyright 2026 Sonic Dominion. MIT License.",
    "category": "Music",
    "shortDescription": "The lightweight soundboard for streaming and voice chat",
    "longDescription": "Fire sounds from global hotkeys into your headphones and a virtual cable at the same time. Banks with Numpad slots, auto push-to-talk, phone remote, recorder.",
    "homepage": "https://github.com/mohammadaboalnadar/Soundboard",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRjFCOEE3NUNFNjhCRTAKUldUZ2krWmNwN2p4VTVZdUY4Nk16UE1FTTladVkyb2VRaHc2ZTlpRUI2VkZSRjc4V2dUVlRmQU8K",
      "endpoints": [
        "https://github.com/mohammadaboalnadar/Soundboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
